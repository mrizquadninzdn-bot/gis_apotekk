<svg width="520" height="180" viewBox="0 0 520 180" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="pinGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#1E8A6E"/>
      <stop offset="100%" stop-color="#0F5C48"/>
    </linearGradient>
  </defs>

  <!-- Map pin shape -->
  <g transform="translate(15,10)">
    <path d="M60 0 C93 0 120 26 120 60 C120 100 60 150 60 150 C60 150 0 100 0 60 C0 26 27 0 60 0 Z"
          fill="url(#pinGrad)"/>
    <circle cx="60" cy="58" r="38" fill="#FFFFFF"/>

    <!-- Cross (medical / apotek symbol) -->
    <rect x="48" y="30" width="24" height="56" rx="4" fill="#1E8A6E"/>
    <rect x="32" y="46" width="56" height="24" rx="4" fill="#1E8A6E"/>
  </g>

  <!-- Text -->
  <g transform="translate(175,75)">
    <text x="0" y="20" font-family="Arial, Helvetica, sans-serif" font-size="40" font-weight="800" fill="#0F5C48">GIS</text>
    <text x="98" y="20" font-family="Arial, Helvetica, sans-serif" font-size="40" font-weight="800" fill="#1E8A6E">APOTEK</text>
    <text x="0" y="45" font-family="Arial, Helvetica, sans-serif" font-size="15" fill="#4B5563" letter-spacing="1.5">SISTEM INFORMASI GEOGRAFIS</text>
  </g>
</svg>
